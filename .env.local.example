# ==============================================================================
# KONFIGURASI GOOGLE CLOUD: GOOGLE SHEETS & GOOGLE DRIVE
# Infra-Map GIS Kota Lubuklinggau
# ==============================================================================

# 1. Email Service Account dari Google Cloud Console
GOOGLE_CLIENT_EMAIL=gis-surveyor-bot@infra-mapping-system.iam.gserviceaccount.com

# 2. Private Key dari file JSON Service Account (sertakan -----BEGIN PRIVATE KEY----- dsb)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. ID Google Spreadsheet (didapat dari URL link Google Sheets Anda)
# Contoh URL: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# Ambil ID di tengahnya: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# 4. ID Folder Google Drive untuk menyimpan Foto Tiang Lapangan
# Contoh URL Folder: https://drive.google.com/drive/folders/17B_9J8xYwZ123456abcdef
# Ambil ID di ujungnya: 17B_9J8xYwZ123456abcdef
GOOGLE_DRIVE_FOLDER_ID=17B_9J8xYwZ123456abcdef

# Base URL Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database utama untuk VPS (PostgreSQL lokal atau managed Postgres)
DATABASE_URL=postgresql://gis_app:password@127.0.0.1:5432/gis_db
DATABASE_SSL=false
