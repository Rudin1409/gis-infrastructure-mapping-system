# Infra-Map GIS Kota Lubuklinggau — contoh environment development.
# Salin ke .env.local; jangan pakai database produksi untuk pengujian CRUD.

# PostgreSQL diprioritaskan jika koneksi terisi; jika kosong, memakai Supabase.
DATABASE_URL=
# Contoh: postgresql://gis_app:password@127.0.0.1:5432/gis_dev
# SSL kosong = deteksi hostname, true/false = override eksplisit.
DATABASE_SSL=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Supabase: isi project development sendiri.
# Kode lama memiliki fallback project; env kosong tidak mengaktifkan mode mock.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apps Script: upload foto, mirror Sheets, fallback login.
# Variabel public diprioritaskan; kosong masih dapat memakai URL fallback lama.
NEXT_PUBLIC_APPS_SCRIPT_URL=
APPS_SCRIPT_URL=

# Google langsung: service account, spreadsheet dan folder Drive.
GOOGLE_CLIENT_EMAIL=
# Isi PEM di dalam tanda kutip dengan \n sebagai pemisah baris.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Maps / Street View / geocoding.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Key server foto Street View; fallback ke key browser jika kosong.
GOOGLE_MAPS_API_KEY=
LOCATIONIQ_API_KEY=

# OpenRouter: gunakan key sendiri.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# Isi PIN privat sendiri; kode lama memiliki PIN fallback jika kosong.
MASTER_SECURITY_PIN=

# Metadata; NEXT_PUBLIC_APP_URL belum dibaca runtime src/.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_* terlihat oleh browser. Jangan isi secret server di variabel public.
# Flag berikut mengaktifkan pembatasan Vercel; biarkan mati untuk development penuh.
# NEXT_PUBLIC_VERCEL_ENV=preview
# VERCEL=1

# Khusus script migrasi (terpisah dari client Supabase aplikasi).
# SUPABASE_URL=
# SUPABASE_KEY=
# DB_PASSWORD=
# PROJECT_REF=
# GIS_DEPLOY_ROOT=/home/admin/gis-deploy
